# Sao chép file này thành .env rồi điền giá trị thật. Không commit file .env.

PORT=5000

# Kết nối PostgreSQL. Database DB_NAME sẽ được tạo tự động khi chạy "npm run db:init".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrm
DB_USER=postgres
DB_PASSWORD=

# Khoá ký token đăng nhập: đặt một chuỗi ngẫu nhiên dài, ví dụ sinh bằng
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Gốc của link đặt lại mật khẩu
FRONTEND_URL=http://localhost:5173

# Tài khoản admin đầu tiên do "npm run db:init" tạo (bỏ trống thì dùng admin@hrm.local / 123456)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Tài khoản dùng cho "npm test" (bỏ trống thì dùng admin@hrm.local, employee@hrm.local, mật khẩu 123456)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_EMPLOYEE_EMAIL=
TEST_EMPLOYEE_PASSWORD=
