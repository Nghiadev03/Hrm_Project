# Sao chép file này thành .env rồi điền giá trị thật. Không commit file .env.

PORT=5000

# Kết nối PostgreSQL. Database DB_NAME sẽ được tạo tự động khi chạy "npm run db:init".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrm
DB_USER=postgres
DB_PASSWORD=

# Khoá ký token đăng nhập: đặt một chuỗi ngẫu nhiên dài, ví dụ sinh bằng
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Tài khoản admin đầu tiên do "npm run db:init" tạo (bỏ trống thì dùng admin@hrm.local / 123456)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Chatbot hỏi đáp tài liệu (Gemini). Tạo key tại https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Để trống rồi chạy "npm run chat:init", script tự tạo kho và điền vào đây
GEMINI_STORE_NAME=
# Số câu hỏi tối đa mỗi người mỗi ngày, dung lượng tối đa mỗi file tải lên (MB)
CHAT_DAILY_LIMIT=30
MAX_UPLOAD_MB=20
